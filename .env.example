# Backend configuration. Do not commit real credentials in a .env file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg:///peopleops_decision_lab
M2_TEST_DATABASE_URL=postgresql+psycopg:///peopleops_decision_lab_test
# Comma-separated browser origins. Required when APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
